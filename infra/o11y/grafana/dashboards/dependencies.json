{
  "uid": "dependencies",
  "title": "Dependencies",
  "description": "USE for the backing services: the apps' Postgres pools, Postgres, Redis and BullMQ.",
  "tags": [
    "o11y",
    "use"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "annotations": {
    "list": [
      {
        "name": "k6 runs",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "orange",
        "expr": "max by (testid) (k6_vus_max) > 0",
        "step": "5s",
        "titleFormat": "k6 {{testid}}"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "qryType": 1,
          "query": "label_values(pg_up, deployment_environment)",
          "refId": "env"
        },
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "sort": 1
      },
      {
        "name": "job",
        "label": "App service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "qryType": 1,
          "query": "label_values(db_client_connection_max{deployment_environment=\"$env\"}, job)",
          "refId": "job"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      },
      {
        "name": "db",
        "label": "Database",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "qryType": 1,
          "query": "label_values(pg_stat_database_numbackends{deployment_environment=\"$env\", datname!~\"template.*|postgres\"}, datname)",
          "refId": "db"
        },
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "sort": 1
      },
      {
        "name": "redis",
        "label": "Redis",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "qryType": 1,
          "query": "label_values(redis_up{deployment_environment=\"$env\"}, instance)",
          "refId": "redis"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Postgres connection pool (app side)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Pool connections in use",
      "description": "Utilization: connections checked out of each process's pool, against the pool's max.",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "max .*"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (job, instance) (db_client_connection_count{deployment_environment=\"$env\", job=~\"$job\", db_client_connection_state=\"used\"})",
          "legendFormat": "used {{job}} {{instance}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (job, instance) (db_client_connection_max{deployment_environment=\"$env\", job=~\"$job\"})",
          "legendFormat": "max {{job}} {{instance}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Requests waiting for a connection",
      "description": "Saturation: queries queued because every pool connection is in use. Above 0 while Postgres is idle means the pool, not the database, is the bottleneck.",
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (job, instance) (db_client_connection_pending_requests{deployment_environment=\"$env\", job=~\"$job\"})",
          "legendFormat": "{{job}} {{instance}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Queries/s",
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (job, operation) (label_replace(rate(db_client_operation_duration_seconds_count{deployment_environment=\"$env\", job=~\"$job\"}[$__rate_interval]), \"operation\", \"$1\", \"db_operation_name\", \"\\\\s*(\\\\S+)\\\\s*\"))",
          "legendFormat": "{{operation}} {{job}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Query duration p95",
      "description": "Measured in the app, so it includes network round-trips to Postgres.",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (job, operation, le) (label_replace(rate(db_client_operation_duration_seconds_bucket{deployment_environment=\"$env\", job=~\"$job\"}[$__rate_interval]), \"operation\", \"$1\", \"db_operation_name\", \"\\\\s*(\\\\S+)\\\\s*\")))",
          "legendFormat": "{{operation}} {{job}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Query errors/s",
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (job, operation, error_type) (label_replace(rate(db_client_operation_duration_seconds_count{deployment_environment=\"$env\", job=~\"$job\", error_type!=\"\"}[$__rate_interval]), \"operation\", \"$1\", \"db_operation_name\", \"\\\\s*(\\\\S+)\\\\s*\"))",
          "legendFormat": "{{error_type}} {{operation}} {{job}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "row",
      "title": "Postgres server",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Server connections by state",
      "description": "All pools across all app processes share max_connections. Many 'idle in transaction' means transactions are left open between queries.",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 20
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "max_connections"
            },
            "properties": [
              {
                "id": "custom.stacking",
                "value": {
                  "mode": "none"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (state) (pg_stat_activity_count{deployment_environment=\"$env\", datname=\"$db\"})",
          "legendFormat": "{{state}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(pg_settings_max_connections{deployment_environment=\"$env\"})",
          "legendFormat": "max_connections"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Transactions/s",
      "gridPos": {
        "x": 8,
        "y": 18,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(pg_stat_database_xact_commit_total{deployment_environment=\"$env\", datname=\"$db\"}[$__rate_interval]))",
          "legendFormat": "commit"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(pg_stat_database_xact_rollback_total{deployment_environment=\"$env\", datname=\"$db\"}[$__rate_interval]))",
          "legendFormat": "rollback"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Longest open transaction",
      "description": "A long transaction holds locks and keeps VACUUM from removing dead rows.",
      "gridPos": {
        "x": 16,
        "y": 18,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (state) (pg_stat_activity_max_tx_duration{deployment_environment=\"$env\", datname=\"$db\"})",
          "legendFormat": "{{state}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Buffer cache hit ratio",
      "description": "Share of page reads served from shared_buffers. 'Read' can still come from the OS page cache, so a lower ratio doesn't always mean disk IO.",
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(pg_stat_database_blks_hit_total{deployment_environment=\"$env\", datname=\"$db\"}[$__rate_interval])) / (sum(rate(pg_stat_database_blks_hit_total{deployment_environment=\"$env\", datname=\"$db\"}[$__rate_interval])) + sum(rate(pg_stat_database_blks_read_total{deployment_environment=\"$env\", datname=\"$db\"}[$__rate_interval])))",
          "legendFormat": "hit ratio"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Rows read by sequential scans (top 5 tables)",
      "description": "Rows/s read by full table scans. A table near the top under load usually lacks an index for a hot query.",
      "gridPos": {
        "x": 8,
        "y": 26,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "topk(5, sum by (relname) (rate(pg_stat_user_tables_seq_tup_read_total{deployment_environment=\"$env\", datname=\"$db\"}[$__rate_interval])))",
          "legendFormat": "{{relname}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Locks, deadlocks, temp files",
      "description": "Temp files are sorts and hashes that didn't fit in work_mem and spilled to disk.",
      "gridPos": {
        "x": 16,
        "y": 26,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (mode) (pg_locks_count{deployment_environment=\"$env\", datname=\"$db\"})",
          "legendFormat": "locks {{mode}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(pg_stat_database_deadlocks_total{deployment_environment=\"$env\", datname=\"$db\"}[$__rate_interval]))",
          "legendFormat": "deadlocks"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(pg_stat_database_temp_files_total{deployment_environment=\"$env\", datname=\"$db\"}[$__rate_interval]))",
          "legendFormat": "temp files/s"
        }
      ]
    },
    {
      "id": 14,
      "type": "row",
      "title": "Redis",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Main-thread CPU",
      "description": "Redis runs commands on one thread, so it saturates near 100% of one core regardless of how many cores the host has.",
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_replace(rate(redis_cpu_user_main_thread_seconds_total{deployment_environment=\"$env\", instance=~\"$redis\"}[$__rate_interval]) + rate(redis_cpu_sys_main_thread_seconds_total{deployment_environment=\"$env\", instance=~\"$redis\"}[$__rate_interval]), \"redis\", \"$1\", \"instance\", \"redis://([^:]+):.*\")",
          "legendFormat": "{{redis}}"
        }
      ]
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Commands/s",
      "gridPos": {
        "x": 8,
        "y": 35,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_replace(rate(redis_commands_processed_total{deployment_environment=\"$env\", instance=~\"$redis\"}[$__rate_interval]), \"redis\", \"$1\", \"instance\", \"redis://([^:]+):.*\")",
          "legendFormat": "{{redis}}"
        }
      ]
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Memory used",
      "description": "maxmemory only appears when set; without it Redis grows until the container's memory limit.",
      "gridPos": {
        "x": 16,
        "y": 35,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_replace(redis_memory_used_bytes{deployment_environment=\"$env\", instance=~\"$redis\"}, \"redis\", \"$1\", \"instance\", \"redis://([^:]+):.*\")",
          "legendFormat": "used {{redis}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_replace(redis_memory_max_bytes{deployment_environment=\"$env\", instance=~\"$redis\"} > 0, \"redis\", \"$1\", \"instance\", \"redis://([^:]+):.*\")",
          "legendFormat": "maxmemory {{redis}}"
        }
      ]
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Clients",
      "description": "Blocked clients wait on blocking commands; BullMQ workers block on the queue instance while idle, so a steady non-zero count there is normal.",
      "gridPos": {
        "x": 0,
        "y": 43,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_replace(redis_connected_clients{deployment_environment=\"$env\", instance=~\"$redis\"}, \"redis\", \"$1\", \"instance\", \"redis://([^:]+):.*\")",
          "legendFormat": "connected {{redis}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_replace(redis_blocked_clients{deployment_environment=\"$env\", instance=~\"$redis\"}, \"redis\", \"$1\", \"instance\", \"redis://([^:]+):.*\")",
          "legendFormat": "blocked {{redis}}"
        }
      ]
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "p99 latency (top 5 commands)",
      "description": "Server-side execution time since Redis started (cumulative), so it reacts slowly to a change. The exporter's own admin commands are excluded.",
      "gridPos": {
        "x": 8,
        "y": 43,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "µs",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_replace(topk(5, redis_latency_percentiles_usec{deployment_environment=\"$env\", instance=~\"$redis\", quantile=\"99\", cmd!~\"(info|config|client|slowlog|latency|ping|select|memory|cluster|dbsize|hello)(\\\\|.*)?\"}), \"redis\", \"$1\", \"instance\", \"redis://([^:]+):.*\")",
          "legendFormat": "{{cmd}} {{redis}}"
        }
      ]
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Cache hit ratio, evictions",
      "gridPos": {
        "x": 16,
        "y": 43,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "evicted.*"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
