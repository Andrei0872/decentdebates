{
  "uid": "red",
  "title": "Services (RED)",
  "description": "Rate, errors and duration per service: the API's HTTP routes and the notification worker's jobs. k6 runs appear as annotations and as 'k6 sent' on the request rate.",
  "tags": [
    "o11y",
    "red"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "annotations": {
    "list": [
      {
        "name": "k6 runs",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "orange",
        "expr": "max by (testid) (k6_vus_max{testid=~\"$testid\"}) > 0",
        "step": "5s",
        "titleFormat": "k6 {{testid}}"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "qryType": 1,
          "query": "label_values(http_server_request_duration_seconds_count, deployment_environment)",
          "refId": "env"
        },
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "sort": 1
      },
      {
        "name": "route",
        "label": "Route",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "qryType": 1,
          "query": "label_values(http_server_request_duration_seconds_count{deployment_environment=\"$env\", job=\"api\"}, http_route)",
          "refId": "route"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      },
      {
        "name": "testid",
        "label": "k6 run",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "qryType": 1,
          "query": "label_values(k6_vus_max, testid)",
          "refId": "testid"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "API: HTTP",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Requests/s by route",
      "description": "Rate. 'k6 sent' is the load k6 generated; if served requests fall below it, requests are failing before reaching a route or k6 is measuring something else. Unmatched requests (404s) have an empty route.",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "k6 sent"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (http_route) (rate(http_server_request_duration_seconds_count{deployment_environment=\"$env\", job=\"api\", http_route=~\"$route\"}[$__rate_interval]))",
          "legendFormat": "{{http_route}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(k6_http_reqs_total{testid=~\"$testid\"}[$__rate_interval]))",
          "legendFormat": "k6 sent"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Server error ratio (5xx)",
      "description": "Errors: share of responses that were 5xx (0 when there were none, rather than no data). This is the availability SLI's basis; 4xx are client errors and shown separately.",
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum by (http_route) (rate(http_server_request_duration_seconds_count{deployment_environment=\"$env\", job=\"api\", http_route=~\"$route\", http_response_status_code=~\"5..\"}[$__rate_interval])) or sum by (http_route) (rate(http_server_request_duration_seconds_count{deployment_environment=\"$env\", job=\"api\", http_route=~\"$route\"}[$__rate_interval])) * 0) / sum by (http_route) (rate(http_server_request_duration_seconds_count{deployment_environment=\"$env\", job=\"api\", http_route=~\"$route\"}[$__rate_interval]))",
          "legendFormat": "{{http_route}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(rate(http_server_request_duration_seconds_count{deployment_environment=\"$env\", job=\"api\", http_route=~\"$route\", http_response_status_code=~\"5..\"}[$__rate_interval])) or sum(rate(http_server_request_duration_seconds_count{deployment_environment=\"$env\", job=\"api\", http_route=~\"$route\"}[$__rate_interval])) * 0) / sum(rate(http_server_request_duration_seconds_count{deployment_environment=\"$env\", job=\"api\", http_route=~\"$route\"}[$__rate_interval]))",
          "legendFormat": "all routes"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Latency p50 / p95 / p99",
      "description": "Duration, all routes. Percentiles are interpolated within histogram buckets (…, 50, 75, 100, 250 ms, …), so they are estimates, coarser between widely spaced buckets.",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(http_server_request_duration_seconds_bucket{deployment_environment=\"$env\", job=\"api\", http_route=~\"$route\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{deployment_environment=\"$env\", job=\"api\", http_route=~\"$route\"}[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_request_duration_seconds_bucket{deployment_environment=\"$env\", job=\"api\", http_route=~\"$route\"}[$__rate_interval])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Latency p95 by route",
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, http_route) (rate(http_server_request_duration_seconds_bucket{deployment_environment=\"$env\", job=\"api\", http_route=~\"$route\"}[$__rate_interval])))",
          "legendFormat": "{{http_route}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Client errors (4xx)/s by status",
      "description": "401: not logged in; 404: unknown resource or route; 429: throttled (THROTTLE_LIMIT / AUTH_THROTTLE_LIMIT).",
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (http_response_status_code) (rate(http_server_request_duration_seconds_count{deployment_environment=\"$env\", job=\"api\", http_route=~\"$route\", http_response_status_code=~\"4..\"}[$__rate_interval]))",
          "legendFormat": "{{http_response_status_code}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Requests/s by status class",
      "gridPos": {
        "x": 12,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 20
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (class) (label_replace(rate(http_server_request_duration_seconds_count{deployment_environment=\"$env\", job=\"api\", http_route=~\"$route\"}[$__rate_interval]), \"class\", \"${1}xx\", \"http_response_status_code\", \"(\\\\d).*\"))",
          "legendFormat": "{{class}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "row",
      "title": "API: real-time connections",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Open SSE streams",
      "description": "Notification count streams. Excluded from the HTTP panels above: each stream is one long request.",
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (instance) (app_sse_active_connections{deployment_environment=\"$env\", job=\"api\"})",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Connected Socket.IO sockets",
      "description": "Messages over these sockets (e.g. comments) aren't measured; see docs/known-issues.md.",
      "gridPos": {
        "x": 12,
        "y": 26,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (app_socketio_namespace, instance) (app_socketio_active_connections{deployment_environment=\"$env\", job=\"api\"})",
          "legendFormat": "{{app_socketio_namespace}} {{instance}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "row",
      "title": "Notification worker: jobs",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Jobs/s",
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (bullmq_queue_name) (rate(bullmq_jobs_completed_total{deployment_environment=\"$env\"}[$__rate_interval]))",
          "legendFormat": "completed {{bullmq_queue_name}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (bullmq_queue_name) (rate(bullmq_jobs_failed_total{deployment_environment=\"$env\"}[$__rate_interval]))",
          "legendFormat": "failed {{bullmq_queue_name}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Job failure ratio",
      "description": "Failed attempts over finished attempts. A job retried after a failure counts once per failed attempt.",
      "gridPos": {
        "x": 8,
        "y": 35,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum by (bullmq_queue_name) (rate(bullmq_jobs_failed_total{deployment_environment=\"$env\"}[$__rate_interval])) or sum by (bullmq_queue_name) (rate(bullmq_jobs_completed_total{deployment_environment=\"$env\"}[$__rate_interval])) * 0) / (sum by (bullmq_queue_name) (rate(bullmq_jobs_completed_total{deployment_environment=\"$env\"}[$__rate_interval])) + (sum by (bullmq_queue_name) (rate(bullmq_jobs_failed_total{deployment_environment=\"$env\"}[$__rate_interval])) or sum by (bullmq_queue_name) (rate(bullmq_jobs_completed_total{deployment_environment=\"$env\"}[$__rate_interval])) * 0))",
          "legendFormat": "{{bullmq_queue_name}}"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Job duration p50 / p95 / p99",
      "description": "From the moment a worker picks the job up to when it finishes; time spent waiting in the queue isn't included (see queue depth on the Dependencies dashboard).",
      "gridPos": {
        "x": 16,
        "y": 35,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(bullmq_job_duration_milliseconds_bucket{deployment_environment=\"$env\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(bullmq_job_duration_milliseconds_bucket{deployment_environment=\"$env\"}[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(bullmq_job_duration_milliseconds_bucket{deployment_environment=\"$env\"}[$__rate_interval])))",
          "legendFormat": "p99"
        }
      ]
    }
  ]
}
