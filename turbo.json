{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [
        "dist/**",
        ".next/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "lint:fix": {
      "cache": false,
      "dependsOn": [
        "^lint:fix"
      ]
    },
    "format": {
      "dependsOn": [
        "^format"
      ]
    },
    "format:fix": {
      "cache": false,
      "dependsOn": [
        "^format:fix"
      ]
    },
    "test:unit": {
      "dependsOn": [
        "^build"
      ]
    },
    "test:integration:only": {
      "dependsOn": [
        "^build"
      ]
    },
    "start:prod": {
      "dependsOn": ["build"],
      "persistent": true,
      "cache": false,
      "passThroughEnv": [
        "OTEL_*",
        "THROTTLE_LIMIT",
        "AUTH_THROTTLE_LIMIT",
        "SESSION_COOKIE_SECURE"
      ]
    }
  }
}
