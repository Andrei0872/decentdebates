CLIENT_URL=http://localhost:3000
REDIS_SESSIONS_URL=redis://localhost:6379
REDIS_QUEUE_URL=redis://localhost:6380
REDIS_CACHE_URL=redis://localhost:6381

# Secrets go in `.env.local` (gitignored):
# COOKIE_SECRET=  # in production at least 32 random characters (`openssl rand -base64 32`)

# Optional; schema defaults shown.
# SESSION_COOKIE_NAME=sessionId
# Defaults to true when NODE_ENV=production.
# SESSION_COOKIE_SECURE=
# Reverse proxies in front of the API. 0 locally, 1 behind a web server.
# TRUST_PROXY_HOPS=0
# Requests per minute. Mutations are limited per user, login/register per IP.
# Raise AUTH_THROTTLE_LIMIT only for load tests, where k6 logs in many users
# from one IP.
# THROTTLE_LIMIT=30
# AUTH_THROTTLE_LIMIT=10
