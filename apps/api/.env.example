# In production: at least 32 random characters (`openssl rand -base64 32`).
COOKIE_SECRET=null
SESSION_COOKIE_NAME=sessionId

# Optional; defaults shown. Set these when Redis / the client are not on localhost.
CLIENT_URL=http://localhost:3000
REDIS_HOST=localhost
REDIS_PORT=6379

# Defaults to true when NODE_ENV=production. Set to false for production builds
# served over plain HTTP (`start:prod:local`, `start:prod:containers`).
# SESSION_COOKIE_SECURE=false

# Reverse proxies in front of the API. 0 locally, 1 behind a web server.
# TRUST_PROXY_HOPS=0
