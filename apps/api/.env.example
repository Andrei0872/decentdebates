# In production: at least 32 random characters (`openssl rand -base64 32`).
COOKIE_SECRET=null
SESSION_COOKIE_NAME=sessionId

# Optional; defaults shown. Set these when Redis / the client are not on localhost.
CLIENT_URL=http://localhost:3000
REDIS_SESSIONS_URL=redis://localhost:6379
REDIS_QUEUE_URL=redis://localhost:6380
REDIS_CACHE_URL=redis://localhost:6381

# Defaults to true when NODE_ENV=production. Set to false for production builds
# served over plain HTTP (`start:prod:local`, `start:prod:containers`).
# SESSION_COOKIE_SECURE=false

# Reverse proxies in front of the API. 0 locally, 1 behind a web server.
# TRUST_PROXY_HOPS=0

# Requests per minute; defaults shown. Mutations are limited per user,
# login/register per IP. Raise AUTH_THROTTLE_LIMIT only for load tests, where
# k6 logs in many users from one IP. On host runs these must be real env vars,
# not set here (see docs/known-issues.md).
# THROTTLE_LIMIT=30
# AUTH_THROTTLE_LIMIT=10
