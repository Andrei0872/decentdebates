{
  "name": "@decentdebates/db",
  "version": "0.0.1",
  "private": true,
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:clean": "rm -rf dist && tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "lint": "eslint \"{src,data,migrations}/**/*.ts\" knexfile.ts --max-warnings 0",
    "lint:fix": "eslint \"{src,data,migrations}/**/*.ts\" knexfile.ts --fix",
    "format": "prettier --check \"{src,data,migrations}/**/*.ts\" knexfile.ts",
    "format:fix": "prettier --write \"{src,data,migrations}/**/*.ts\" knexfile.ts",
    "migrate:latest": "tsc -p tsconfig.json && knex --knexfile dist/knexfile.js migrate:latest",
    "migrate:rollback": "tsc -p tsconfig.json && knex --knexfile dist/knexfile.js migrate:rollback",
    "migrate:status": "tsc -p tsconfig.json && knex --knexfile dist/knexfile.js migrate:status",
    "migrate:make": "knex --knexfile dist/knexfile.js migrate:make -x ts --migrations-directory ../migrations",
    "seed": "tsc -p tsconfig.json && knex --knexfile dist/knexfile.js seed:run",
    "seed:file": "tsc -p tsconfig.json && knex --knexfile dist/knexfile.js seed:run --specific"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@opentelemetry/api": "1.9.1",
    "bcrypt": "^5.1.0",
    "dotenv": "^16.0.3",
    "knex": "^2.4.2",
    "pg": "^8.8.0"
  },
  "devDependencies": {
    "@decentdebates/eslint-config": "workspace:*",
    "@types/bcrypt": "^5.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.4",
    "prettier": "^3.0.0",
    "typescript": "^5.7.0"
  }
}
